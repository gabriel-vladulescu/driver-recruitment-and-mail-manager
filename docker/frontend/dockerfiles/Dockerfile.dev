FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (including dev dependencies)
RUN npm ci --include=dev

# Copy source code
COPY . .

# Expose port
EXPOSE 5173

# Configure Vite for Docker
ENV HOST=0.0.0.0
ENV PORT=5173

# Start in development mode with hot reload
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]