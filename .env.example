# General Configuration
NODE_ENV=development

# Port Configuration
AVANTY_MAIL_API_PORT=3000
AVANTY_MAIL_PORT=5173
WEBSITE_PORT=8080

# Avanty Mail Database Configuration
AVANTY_DB_ROOT_PASSWORD=rootpassword
AVANTY_DB_NAME=avanty_mail
AVANTY_DB_USER=avanty_user
AVANTY_DB_PASSWORD=avanty_password
AVANTY_DB_PORT=3306

# Avanty Mail JWT Configuration
AVANTY_JWT_SECRET=your-super-secret-jwt-key-here
AVANTY_JWT_EXPIRES_IN=7d

# Avanty Mail Admin Authentication
AVANTY_ADMIN_EMAIL=admin@avanty.works
AVANTY_ADMIN_PASSWORD=your-admin-password

# Avanty Mail CORS Configuration
AVANTY_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Avanty Mail SMTP Configuration
AVANTY_SMTP_HOST=smtp.gmail.com
AVANTY_SMTP_PORT=587
AVANTY_SMTP_SECURE=false
AVANTY_SMTP_USER=your-email@gmail.com
AVANTY_SMTP_PASSWORD=your-email-password

# Avanty Mail IMAP Configuration
AVANTY_IMAP_HOST=imap.gmail.com
AVANTY_IMAP_PORT=993
AVANTY_IMAP_SECURE=true
AVANTY_IMAP_USER=your-email@gmail.com
AVANTY_IMAP_PASSWORD=your-email-password

# Frontend Environment Variables
AVANTY_MAIL_API_BASE_URL=http://localhost:4000
VITE_MAIL_API_BASE_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000
VITE_APP_NAME=Bolt Driver Recruitment
VITE_PHONE_NUMBER=0756123499
VITE_EMAIL=contact@bloom.roo